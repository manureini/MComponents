@page "/"

<h1>MComponents examples</h1>

<p>
    Explore simple and advanced examples for every public component, with links to the corresponding
    <a href="https://github.com/manureini/MComponents/wiki" target="_blank">GitHub Wiki</a> pages.
</p>

<div class="row">
    @foreach (var component in Components)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">@component</h2>
                    <a class="card-link" href="components#@component.ToLowerInvariant()">Examples</a>
                    <a class="card-link"
                       href="https://github.com/manureini/MComponents/wiki/@component"
                       target="_blank">Wiki</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] Components =
    {
        "MAccordion",
        "MBadge",
        "MCards",
        "MForm",
        "MGrid",
        "MInputFile",
        "MPaint",
        "MPopup",
        "MProgressbar",
        "MQueryBuilder",
        "MScrollAnchor",
        "MSelect",
        "MSeparator",
        "MSpinner",
        "MTabs",
        "MToaster",
        "MTooltip",
        "MWizard"
    };
}
